{
  "manifest_version": 3,
  "name": "台股收盤速覽",
  "short_name": "收盤速覽",
  "version": "1.3.1",
  "description": "收盤後一頁看完自選股：K 線與支撐壓力、關聯脈絡、新聞與行事曆、同業、族群強弱、估值、大戶持股、每週報告。",
  "permissions": ["storage", "unlimitedStorage", "alarms", "notifications"],
  "host_permissions": ["https://api.finmindtrade.com/*", "https://www.twse.com.tw/*", "https://www.tpex.org.tw/*", "https://news.google.com/*", "https://opendata.tdcc.com.tw/*", "https://openapi.twse.com.tw/*", "https://joemori.github.io/*", "https://www.ptt.cc/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "台股收盤速覽",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
